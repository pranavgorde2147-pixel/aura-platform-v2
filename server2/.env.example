HOST=0.0.0.0
PORT=8001
MODEL_NAME=Qwen3.5-0.8B
# Local GGUF checkpoint (llama.cpp). For a transformers dir point this at the
# directory instead. On Render set AURA_SKIP_MODEL_LOAD=1 and use the external
# provider rather than a local file.
MODEL_PATH=/models/Qwen3.5-0.8B-Q4_K_M.gguf
# Must exactly match Server 1's INTERNAL_API_TOKEN; configure independently
# in the process environment or this ignored .env file, never commit the real value.
INTERNAL_API_TOKEN=
AURA_SKIP_MODEL_LOAD=false
# Tuned for the local 0.8B GGUF; the external provider path prefers a larger
# MAX_NEW_TOKENS and higher temperature.
MAX_NEW_TOKENS=256
TEMPERATURE=0.2
TOP_P=0.9

# Local GPU quantization (set AURA_SKIP_MODEL_LOAD=false first).
# LOAD_IN_4BIT=1 fits a 4B model on a ~6 GB CUDA GPU. Requires the extra
# deps in requirements-4bit.txt (bitsandbytes + accelerate).
LOAD_IN_4BIT=0
# Alternatively QUANTIZATION=4bit|8bit|none overrides LOAD_IN_4BIT/LOAD_IN_8BIT.
QUANTIZATION=

# GGUF model loading (optional). When MODEL_PATH points at a .gguf file, the
# llama.cpp runtime is used instead of transformers. Install requirements-gguf.txt.
# GGUF_N_GPU_LAYERS=0            # -1 unloads all layers to GPU when CUDA is present
# GGUF_N_CTX=2048
# REPEAT_PENALTY=1.2             # reduces echo/repetition loops on small hybrids
# MIN_P=0.05

# Object storage engine (formerly the standalone storage service). Storage
# metadata DB and backend live here now. Set STORAGE_API_TOKEN to match Server 1's
# token, or leave blank to reuse INTERNAL_API_TOKEN.
STORAGE_API_TOKEN=
STORAGE_BACKEND=local
STORAGE_DATA_DIR=./data
# STORAGE_DATABASE_URL=sqlite+aiosqlite:///./data/storage.db
# MAX_UPLOAD_SIZE_BYTES=52428800
# ALLOWED_CONTENT_TYPES=

# External LLM Provider (Groq)
EXTERNAL_AI_URL=https://api.groq.com/openai/v1
EXTERNAL_AI_KEY=
EXTERNAL_MODEL=qwen/qwen3.8-27b

# ---------------------------------------------------------------------------
# Per-user Brain manager
# ---------------------------------------------------------------------------
# Every registered user owns one Brain, and every Brain owns one dedicated
# LLM runtime. The runtime mode decides what "dedicated" means and is always
# reported honestly in the registry (runtime_isolation) and in every
# inference response - a simulated runtime is never presented as a
# production-isolated one.
#
#   dedicated  - provisioning copies the complete configured local model into
#                each Brain's personal_llm/model_weights/ folder. Each runtime
#                owns its own weights, context and KV cache.
#   external   - one provider handle per Brain. The provider's weights are
#                shared, the context is not
#                (context_isolated_shared_weights).
#   simulated  - the deterministic simulator used by the test-suite and by
#                deployments that cannot load a model (simulated).
#
# Leave BRAIN_RUNTIME_MODE empty to let the service choose: "external" when
# AURA_SKIP_MODEL_LOAD=1 and an external provider is configured, "simulated"
# when no model can be loaded, "dedicated" otherwise.
BRAIN_RUNTIME_MODE=dedicated
# Force a specific adapter: auto | llama_cpp | transformers | simulated.
# "auto" picks llama_cpp for a .gguf artifact and transformers otherwise.
BRAIN_RUNTIME_ADAPTER=auto
# Maximum number of Brains that may hold a live runtime in this process.
# A Brain that cannot get capacity is reported as waiting_for_resources or
# resource_limited - it is never silently served by another Brain's runtime.
BRAIN_MAX_CONCURRENT_RUNTIMES=8
# Maximum number of concurrent requests served for one Brain.
BRAIN_MAX_CONCURRENT_REQUESTS_PER_BRAIN=1
# Context budget of one Brain's runtime.
BRAIN_MAX_CONTEXT_TOKENS=8192
# Root directory of per-Brain resource directories. In Docker Compose this is
# overridden to /var/data/brains inside the persistent server2_data volume.
BRAIN_RESOURCE_ROOT=./data/brains
# The private SQLite vault, objects and indexes live inside each directory
# beneath BRAIN_RESOURCE_ROOT.
# Operator backups are stored outside each live Brain directory.
BRAIN_VAULT_BACKUP_ROOT=./brain_vault_backups
# Processing limits per Brain.
BRAIN_MAX_JOBS_PER_BRAIN=64
BRAIN_JOB_MAX_ATTEMPTS=3
# A Brain is only ever served by its own dedicated runtime. There is no
# shared-runtime fallback: if a Brain's runtime cannot be created, the Brain
# records an honest failure state and inference answers 503.
# Comma-separated owner ids allowed to call the administrative registry API
# (/v1/admin/brains). An empty value disables the administrative API.
BRAIN_ADMIN_OWNER_IDS=
