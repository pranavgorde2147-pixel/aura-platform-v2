HOST=0.0.0.0
PORT=8001
MODEL_NAME=Qwen3.5-0.8B
# Local GGUF checkpoint (llama.cpp). For a transformers dir point this at the
# directory instead. On Render set AURA_SKIP_MODEL_LOAD=1 and use the external
# provider rather than a local file.
MODEL_PATH=/models/Qwen3.5-0.8B-Q4_K_M.gguf
INTERNAL_API_TOKEN=
AURA_SKIP_MODEL_LOAD=false
# Tuned for the local 0.8B GGUF; the external provider path prefers a larger
# MAX_NEW_TOKENS and higher temperature.
MAX_NEW_TOKENS=256
TEMPERATURE=0.2
TOP_P=0.9

# Local GPU quantization (set AURA_SKIP_MODEL_LOAD=false first).
# LOAD_IN_4BIT=1 fits a 4B model on a ~6 GB CUDA GPU. Requires the extra
# deps in requirements-4bit.txt (bitsandbytes + accelerate).
LOAD_IN_4BIT=0
# Alternatively QUANTIZATION=4bit|8bit|none overrides LOAD_IN_4BIT/LOAD_IN_8BIT.
QUANTIZATION=

# GGUF model loading (optional). When MODEL_PATH points at a .gguf file, the
# llama.cpp runtime is used instead of transformers. Install requirements-gguf.txt.
# GGUF_N_GPU_LAYERS=0            # -1 unloads all layers to GPU when CUDA is present
# GGUF_N_CTX=2048
# REPEAT_PENALTY=1.2             # reduces echo/repetition loops on small hybrids
# MIN_P=0.05

# Object storage engine (formerly a separate Server 3). Storage metadata DB and
# backend live here now. Set STORAGE_API_TOKEN to match Server 1's token, or
# leave blank to reuse INTERNAL_API_TOKEN.
STORAGE_API_TOKEN=
STORAGE_BACKEND=local
STORAGE_DATA_DIR=./data
# STORAGE_DATABASE_URL=sqlite+aiosqlite:///./data/storage.db
# MAX_UPLOAD_SIZE_BYTES=52428800
# ALLOWED_CONTENT_TYPES=

# External LLM Provider (Groq)
EXTERNAL_AI_URL=https://api.groq.com/openai/v1
EXTERNAL_AI_KEY=
EXTERNAL_MODEL=qwen/qwen3.8-27b
