# Server 3 - AURA Storage Engine
HOST=0.0.0.0
PORT=8002
ENVIRONMENT=production
SERVICE_NAME=AURA Storage Engine

# Shared internal service token. Must match Server 1's STORAGE_API_TOKEN.
STORAGE_API_TOKEN=change-me-storage-token

# Backend: "local" (filesystem) or "s3" (MinIO / S3-compatible)
STORAGE_BACKEND=local
STORAGE_DATA_DIR=/data
STORAGE_LOCAL_ROOT=/data/objects

# Metadata database. Defaults to an embedded SQLite file under STORAGE_DATA_DIR.
# For production, point this at PostgreSQL, e.g.:
# STORAGE_DATABASE_URL=postgresql+asyncpg://aura:aura@postgres:5432/aura_storage
STORAGE_DATABASE_URL=

# Limits / policy
MAX_UPLOAD_SIZE_BYTES=52428800
# Comma separated allow-list. Empty means "allow all content types".
ALLOWED_CONTENT_TYPES=
DEFAULT_RETENTION_DAYS=0

# S3 / MinIO settings (only used when STORAGE_BACKEND=s3)
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=aura-objects
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_USE_SSL=false
