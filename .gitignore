# Secrets - never commit these (keep .env.example templates)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/

# Virtual environments
.venv/
venv/

# Testing and tooling
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Logs
*.log

# Local infrastructure artifacts (Qdrant data, markers) - repo root only, so
# application source packages named "storage" are never ignored.
/storage/
/snapshots/
/.qdrant-initialized

# Server 2 local model artifacts; only the bundled default checkpoint is tracked.
server2/models/
/server2/*.gguf
!/server2/Qwen3.5-0.8B-Q4_K_M.gguf

# Server 2 object-storage data (SQLite metadata + objects)
server2/data/

# Server 2 private per-Brain vaults and operator backups
server2/brain_vaults/
server2/brain_vault_backups/
