APP_NAME=AURA Backend
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_IMAGE_NAME=aura-backend:latest
BACKEND_CONTAINER_NAME=aura-backend
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=aura-postgres
POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=aura
POSTGRES_PORT=5432
POSTGRES_URL=postgresql+psycopg://aura:aura@postgres:5432/aura
REDIS_IMAGE=redis:7-alpine
REDIS_CONTAINER_NAME=aura-redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
QDRANT_IMAGE=qdrant/qdrant:v1.10.1
QDRANT_CONTAINER_NAME=aura-qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
# Required for Qdrant Cloud / any secured Qdrant instance. Sent as the
# ``api-key`` header. Leave empty for an unauthenticated local Qdrant.
# QDRANT_URL must include an explicit scheme, e.g.
# https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Server 2 - AURA Brain (inference API + object storage API).
# AI_SERVER_MODEL must match the model Server 2 serves (local GGUF or the external
# provider model used when AURA_SKIP_MODEL_LOAD=1).
#
# On Render, AI_SERVER_URL MUST NOT be localhost/127.0.0.1: those resolve inside
# the Render container, not on your laptop. Point it at the secure tunnel that
# fronts your laptop's Server 2 (see DEPLOYMENT.md, "Option B"). The value is a
# dashboard secret, so it is intentionally left blank in git.
AI_SERVER_URL=
AI_SERVER_MODEL=Qwen3.5-0.8B
# Register each user's canonical Brain with Server 2 after account creation.
BRAIN_REMOTE_PROVISIONING_ENABLED=true
# Comma-separated trusted user UUIDs for metadata-only Brain administration.
# Leave blank to disable operator Brain admin endpoints.
BRAIN_ADMIN_USER_IDS=
# Must exactly match Server 2's INTERNAL_API_TOKEN; configure independently
# in Render/laptop environment, never commit the real value.
INTERNAL_API_TOKEN=

# Registration policy. Leave ALLOW_PUBLIC_REGISTRATION=true to allow anyone to
# create an account via POST /api/v1/users. To close public sign-up, set it to
# false and create the first account with this BOOTSTRAP_TOKEN (sent as the
# X-Bootstrap-Token header). Generate with: openssl rand -hex 32
ALLOW_PUBLIC_REGISTRATION=true
BOOTSTRAP_TOKEN=

# Optional edge/gateway credentials. When the tunnel is protected by Cloudflare
# Access service tokens, set both so every inference request is authenticated at
# the edge as well as by INTERNAL_API_TOKEN. Sent as
# CF-Access-Client-Id / CF-Access-Client-Secret.
# AI_ACCESS_CLIENT_ID=
# AI_ACCESS_CLIENT_SECRET=

# Outbound AI integration behaviour (bounded retries, explicit timeouts).
# AI_REQUEST_TIMEOUT_SECONDS=120
# AI_CONNECT_TIMEOUT_SECONDS=5
# AI_MAX_RETRIES=2
# AI_RETRY_BACKOFF_SECONDS=0.5
# AI_VERIFY_TLS=true

# Object storage (hosted by Server 2). Point
# STORAGE_SERVER_URL at the Server 2 origin and set STORAGE_API_TOKEN to the
# shared internal token (falls back to INTERNAL_API_TOKEN when left empty).
STORAGE_SERVER_URL=http://localhost:8001
STORAGE_API_TOKEN=
MAX_UPLOAD_SIZE_BYTES=52428800

# Optional external AI failover when Server 2 (GPU host) is unreachable
# AI_FALLBACK_ENABLED=false
# AI_FALLBACK_URL=https://api.groq.com/openai/v1
# AI_FALLBACK_KEY=
# AI_FALLBACK_MODEL=llama-3.1-8b-instant

# Semantic memory. When enabled, memories are embedded and indexed in Qdrant;
# retrieval uses vector search with a keyword (ILIKE) fallback if Qdrant is
# unreachable. EMBEDDING_DIMENSION must match the collection and cannot be
# changed after the collection is created (recreate the collection to change it).
MEMORY_VECTOR_SEARCH_ENABLED=true
QDRANT_MEMORY_COLLECTION=brain_memories
# EMBEDDING_DIMENSION=256

# Optional local-development overrides
# QDRANT_LOCAL_PATH=./data/qdrant
# USE_FAKE_REDIS=true
